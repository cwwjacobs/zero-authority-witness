    given-names: "Corey"
    email: "coresynth@gmail.com"
repository-code: "https://github.com/cwwjacobs/zero-authority-witness"
license-url: "https://polyformproject.org/licenses/noncommercial/1.0.0/"
keywords:
  - "zero authority"
  - "prompt injection risk reduction"
  - "intake membrane"
  - "data-authority separation"
  - "evidence only"
  - "receipts"
  - "MCP tool intake"
  - "tool poisoning"
  - "PRISM protocol"
version: "0.1.0-rc1"
date-released: "2026-06-07"
